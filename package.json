{
  "name": "prediction-market-yt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=frontend --filter=backend",
    "dev:all": "turbo run dev",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "dev:backend": "bun --cwd apps/backend --watch index.ts",
    "db:create": "docker run --name prediction-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=prediction_market -p 5432:5432 -d postgres:16",
    "db:start": "docker start prediction-postgres",
    "db:stop": "docker stop prediction-postgres",
    "db:migrate": "bunx prisma migrate deploy --config packages/db/prisma.config.ts",
    "db:seed": "bun apps/backend/seed.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "uuidv4": "^6.2.13"
  }
}
